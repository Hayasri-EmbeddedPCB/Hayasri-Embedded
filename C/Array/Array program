#include <stdio.h>

int main() {
    int marks[5] = {55, 72, 45, 90, 80};
    int total = 0;
    int avg;

    for(int i = 0; i < 5; i++) {
        printf("marks[%d] = %d\n", i, marks[i]);
        total += marks[i];  // Loop-ல total கூட்டு!
    }

    avg = total / 5;
    printf("Total marks : %d\n", total);
    printf("Average     : %d\n", avg);

    return 0;
}
